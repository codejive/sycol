#!/usr/bin/env bash
# sycol: a string-only Tcl subset. Bash 3.2+, no eval of host source.
# Internal functions return through R (value), C (completion), RC/RL (return).
R= C=0 RC=0 RL=0 F=0 NF=0 DEPTH=0
VK=() VV=() GK=() PN=() PA=() PB=() PARENT=(0) NN=() NH=() NATIVE_FILES=() NATIVE_ERRORS=()

# Native handlers receive literal arguments and set R/C, without stdout results.
sy_register() { NN+=("$1"); NH+=("$2"); }

fail() { R=$1; C=1; }
arity() { fail "wrong # args: $1"; }
integer() {
    local n=$1 sign=1
    case $n in -*) sign=-1; n=${n#-};; +*) n=${n#+};; esac
    case $n in ''|*[!0-9]*) fail "expected integer: $1"; return;; esac
    while [[ ${#n} -gt 1 && ${n:0:1} == 0 ]]; do n=${n:1}; done
    if [[ ${#n} -gt 10 ]]; then fail 'integer overflow'; return; fi
    R=$((sign * 10#$n))
    if ((R < -2147483648 || R > 2147483647)); then fail 'integer overflow'; fi
}
truth() {
    case $1 in true) R=1;; false) R=0;; *) integer "$1"; ((C)) || { if ((R)); then R=1; else R=0; fi; };; esac
}
vkey() {
    local name=$1 frame=$F i
    if [[ $name == ::* ]]; then frame=0; name=${name#::}; fi
    if [[ -z $name ]]; then fail 'empty variable name'; return; fi
    for ((i=0;i<${#GK[@]};i++)); do
        if [[ ${GK[i]} == "$frame:$name" ]]; then frame=0; break; fi
    done
    KEY=$frame:$name
}
vget() {
    local KEY i
    vkey "$1"; ((C)) && return
    for ((i=0;i<${#VK[@]};i++)); do
        if [[ ${VK[i]} == "$KEY" ]]; then R=${VV[i]}; return; fi
    done
    fail "no such variable: $1"
}
vset() {
    local KEY i
    vkey "$1"; ((C)) && return
    for ((i=0;i<${#VK[@]};i++)); do
        if [[ ${VK[i]} == "$KEY" ]]; then VV[i]=$2; R=$2; return; fi
    done
    VK+=("$KEY"); VV+=("$2"); R=$2
}
quote_list() {
    local word ch i n out= sep= span pattern='^[^][ {}\$";#\\'$'\t\r\n'']+'
    for word in "$@"; do
        out+=$sep; sep=' '
        if [[ -z $word ]]; then out+='{}'; continue; fi
        n=${#word}
        for ((i=0;i<n;i++)); do
            if [[ ${word:i:1024} =~ $pattern ]]; then
                span=${BASH_REMATCH[0]}; out+=$span; i=$((i+${#span}-1)); continue
            fi
            ch=${word:i:1}
            case $ch in
                $'\n') out+='\n';; $'\r') out+='\r';; $'\t') out+='\t';;
                ' '|\\|'{'|'}'|'['|']'|'$'|'"'|';'|'#') out+=\\$ch;;
                *) out+=$ch;;
            esac
        done
    done
    R=$out
}
# Parser state S/I/N/M/B is dynamically local to eval_script or parse_list.
# M=1 disables substitutions and script separators (list parsing).
escape_char() {
    I=$((I+1))
    if ((I >= N)); then fail 'trailing backslash'; return; fi
    local ch=${S:I:1} span blanks='^[ '$'\t'']+'; I=$((I+1))
    case $ch in
        n) R=$'\n';; r) R=$'\r';; t) R=$'\t';;
        $'\n')
            while ((I<N)) && [[ ${S:I:1024} =~ $blanks ]]; do
                span=${BASH_REMATCH[0]}; I=$((I+${#span}))
            done
            R=' ';;
        *) R=$ch;;
    esac
}
substitute() {
    local ch=${S:I:1} start name span pattern
    case $ch in
        \\) escape_char;;
        '$')
            I=$((I+1)); start=$I
            if [[ ${S:I:1} == '{' ]]; then
                I=$((I+1)); start=$I
                pattern='^[^}]+'
                while ((I<N)) && [[ ${S:I:1024} =~ $pattern ]]; do
                    span=${BASH_REMATCH[0]}; I=$((I+${#span}))
                done
                if ((I==N)); then fail 'missing variable close brace'; return; fi
                name=${S:start:I-start}; I=$((I+1))
            else
                pattern='^[a-zA-Z0-9_:]+'
                while ((I<N)) && [[ ${S:I:1024} =~ $pattern ]]; do
                    span=${BASH_REMATCH[0]}; I=$((I+${#span}))
                done
                name=${S:start:I-start}
                if [[ -z $name ]]; then R='$'; return; fi
            fi
            vget "$name";;
        '[')
            eval_script "$S" "$((I+1))" 1
            I=$END;;
        *) R=$ch; I=$((I+1));;
    esac
}
parse_word() {
    local out= ch mode=bare depth=0 span pattern
    ch=${S:I:1}
    if [[ $ch == '{' ]]; then mode=brace; depth=1; I=$((I+1))
    elif [[ $ch == '"' ]]; then mode=quote; I=$((I+1)); fi
    # Match literal runs in bounded windows. Indexing the complete input once
    # per character is especially costly in multibyte locales. Keep I in host
    # character units, so dispatch still observes the caller's locale.
    if [[ $mode == brace ]]; then pattern='^[^{}\\]+'
    elif [[ $mode == quote ]]; then
        if ((M)); then pattern='^[^"\\]+'; else pattern='^[^"\\$[]+'; fi
    elif ((M)); then pattern='^[^ '$'\t\r\n''\\]+'
    elif ((B)); then pattern='^[^] '$'\t\r\n''\\$[;]+'
    else pattern='^[^ '$'\t\r\n''\\$[;]+'; fi
    while ((I<N)); do
        if [[ ${S:I:1024} =~ $pattern ]]; then
            span=${BASH_REMATCH[0]}; out+=$span; I=$((I+${#span})); continue
        fi
        ch=${S:I:1}
        if [[ $mode == brace ]]; then
            I=$((I+1))
            case $ch in
                '{') depth=$((depth+1));;
                '}') depth=$((depth-1)); if ((depth==0)); then break; fi;;
                \\)
                    if ((I<N)); then
                        if [[ ${S:I:1} == $'\n' ]]; then I=$((I-1)); escape_char; out+=$R; continue; fi
                        out+=$ch${S:I:1}; I=$((I+1)); continue
                    fi;;
            esac
            out+=$ch; continue
        fi
        if [[ $mode == quote && $ch == '"' ]]; then I=$((I+1)); mode=closed; break; fi
        if [[ $mode == bare ]]; then
            case $ch in ' '|$'\t'|$'\r'|$'\n') break;; esac
            if [[ ${S:I:2} == $'\\\n' ]]; then break; fi
            if (( ! M )); then
                [[ $ch == ';' ]] && break
                if ((B)) && [[ $ch == ']' ]]; then break; fi
            fi
        fi
        if ((M)) && [[ $ch != \\ ]]; then R=$ch; I=$((I+1)); else substitute; fi
        ((C)) && return
        out+=$R
    done
    if [[ $mode == brace ]] && ((depth)); then fail 'missing close brace'; return; fi
    if [[ $mode == quote ]]; then fail 'missing close quote'; return; fi
    if [[ $mode != bare ]] && ((I<N)); then
        ch=${S:I:1}
        case $ch in ' '|$'\t'|$'\r'|$'\n') ;; *)
            if ((M)) || [[ $ch != ';' && ( $B == 0 || $ch != ']' ) ]]; then
                fail 'extra characters after close quote or brace'; return
            fi;;
        esac
    fi
    R=$out
}
parse_list() {
    local S=$1 I=0 N=${#1} M=1 B=0 ch span blanks='^[ '$'\t\r\n'']+'
    ITEMS=()
    while ((I<N)); do
        ch=${S:I:1}
        case $ch in ' '|$'\t'|$'\r'|$'\n')
            [[ ${S:I:1024} =~ $blanks ]]; span=${BASH_REMATCH[0]}; I=$((I+${#span})); continue;;
        esac
        if [[ ${S:I:2} == $'\\\n' ]]; then escape_char; continue; fi
        parse_word; ((C)) && return
        ITEMS+=("$R")
    done
}
eval_script() {
    local S=$1 I=${2:-0} N=${#1} B=${3:-0} M=0 ch saved span comment='^[^\\'$'\n'']+' blanks='^[ '$'\t\r'']+'
    local -a words=()
    local DEPTH=$((DEPTH+1))
    R=; C=0
    if ((DEPTH>64)); then fail 'evaluation depth exceeded'; END=$I; return; fi
    while ((I<N)); do
        ch=${S:I:1}
        case $ch in
            ' '|$'\t'|$'\r')
                [[ ${S:I:1024} =~ $blanks ]]; span=${BASH_REMATCH[0]}; I=$((I+${#span})); continue;;
            \\) if [[ ${S:I+1:1} == $'\n' ]]; then saved=$R; escape_char; R=$saved; continue; fi;;
            '#') if ((${#words[@]}==0)); then
                while ((I<N)) && [[ ${S:I:1} != $'\n' ]]; do
                    if [[ ${S:I:1024} =~ $comment ]]; then
                        span=${BASH_REMATCH[0]}; I=$((I+${#span}))
                    elif [[ ${S:I:2} == $'\\\n' ]]; then I=$((I+2)); else I=$((I+1)); fi
                done
                continue
            fi;;
        esac
        if [[ $ch == ';' || $ch == $'\n' ]] || { ((B)) && [[ $ch == ']' ]]; }; then
            if ((${#words[@]})); then dispatch "${words[@]}"; words=(); fi
            I=$((I+1)); END=$I
            ((C)) && return
            if ((B)) && [[ $ch == ']' ]]; then return; fi
            continue
        fi
        parse_word; END=$I; ((C)) && return
        words+=("$R")
    done
    if ((B)); then fail 'missing close bracket'; END=$I; return; fi
    if ((${#words[@]})); then dispatch "${words[@]}"; fi
    END=$I
}
finish_return() {
    if ((C==2)); then
        RL=$((RL-1))
        if ((RL<=0)); then C=$RC; RC=0; RL=0; if ((C==2)); then RL=1; fi; fi
    fi
}
invoke_proc() {
    local idx=$1; shift
    local old=$F frame i n arg value variadic=0
    local -a formals=() names=() defaults=() optional=() actual=("$@") ITEMS=()
    parse_list "${PA[idx]}"; ((C)) && return; formals=("${ITEMS[@]}")
    for arg in "${formals[@]}"; do
        parse_list "$arg"; ((C)) && return
        n=${#ITEMS[@]}
        if ((n<1 || n>2)) || [[ -z ${ITEMS[0]} ]]; then fail 'invalid formal parameter'; return; fi
        names+=("${ITEMS[0]}"); defaults+=("${ITEMS[1]-}"); optional+=("$((n-1))")
    done
    NF=$((NF+1)); frame=$NF; PARENT[frame]=$old; F=$frame
    for ((i=0;i<${#names[@]};i++)); do
        if [[ ${names[i]} == args ]] && ((i==${#names[@]}-1)); then
            quote_list "${actual[@]:i}"; vset args "$R"; variadic=1; break
        fi
        if ((i<${#actual[@]})); then value=${actual[i]}
        elif ((optional[i])); then value=${defaults[i]}
        else arity 'procedure arguments'; break; fi
        vset "${names[i]}" "$value"
    done
    if ((C==0 && !variadic && ${#actual[@]}>${#names[@]})); then arity 'procedure arguments'; fi
    if ((C==0)); then eval_script "${PB[idx]}"; finish_return; fi
    F=$old
    local -a keepk=() keepv=()
    for ((i=0;i<${#VK[@]};i++)); do
        if [[ ${VK[i]} != "$frame:"* ]]; then keepk+=("${VK[i]}"); keepv+=("${VV[i]}"); fi
    done
    VK=("${keepk[@]}"); VV=("${keepv[@]}"); keepk=()
    for value in "${GK[@]}"; do [[ $value == "$frame:"* ]] || keepk+=("$value"); done
    GK=("${keepk[@]}"); unset 'PARENT[frame]'
}
dispatch() {
    local cmd=$1; shift
    local i
    R=; C=0
    # Native commands always win, including over later Tcl definitions.
    for ((i=${#NN[@]}-1;i>=0;i--)); do
        if [[ ${NN[i]} == "$cmd" ]]; then "${NH[i]}" "$@"; return; fi
    done
    for ((i=0;i<${#PN[@]};i++)); do
        if [[ ${PN[i]} == "$cmd" ]]; then invoke_proc "$i" "$@"; return; fi
    done
    fail "unknown command: $cmd"
}
# Lexical absolute paths: collapse separators and dot components, not symlinks.
sy_path() {
    local path=$1 part rest out= count
    local -a parts=()
    [[ $path == /* ]] || path=$PWD/$path
    rest=$path/
    while [[ $rest == */* ]]; do
        part=${rest%%/*}; rest=${rest#*/}
        case $part in
            ''|.) ;;
            ..) count=${#parts[@]}; if ((count)); then unset 'parts[count-1]'; fi;;
            *) parts+=("$part");;
        esac
    done
    for part in "${parts[@]}"; do out+=/$part; done
    R=${out:-/}
}
sy_init_path() {
    local name=$1 value=$2 separator=$3 part
    local -a paths=()
    while [[ $value == *"$separator"* ]]; do
        part=${value%%"$separator"*}; value=${value#*"$separator"}
        [[ -z $part ]] || paths+=("$part")
    done
    [[ -z $value ]] || paths+=("$value")
    quote_list "${paths[@]}"; vset "::$name" "$R"
}
sy_init_paths() {
    local separator=:
    # MSYS/Git Bash uses Windows environment path-list separators too.
    case ${OSTYPE-} in msys*|cygwin*) separator=';';; esac
    sy_init_path sycol_sdk_path "${SYCOL_SDK_PATH-$SYCOL_HOME/../lib}" "$separator"
    sy_init_path sycol_native_path "${SYCOL_NATIVE_PATH-$SYCOL_HOME/../native}" "$separator"
    sy_init_path sycol_source_path "${SYCOL_SOURCE_PATH-}" "$separator"
}
# FIND is separate from C: an absent optional backend is not an error.
sy_find_file() {
    local name=$1 relative=$2 directory
    local -a ITEMS=() paths=()
    FIND=0
    vget "::$name"; ((C)) && return
    parse_list "$R"; ((C)) && return; paths=("${ITEMS[@]}")
    for directory in "${paths[@]}"; do
        [[ -z $directory ]] && continue
        sy_path "$directory/$relative"
        if [[ -e $R || -L $R ]]; then FIND=1; return; fi
    done
    R=
}
load_native() {
    local relative=$1 required=${2:-0} file index
    sy_find_file sycol_native_path "$relative"; ((C)) && return
    if (( ! FIND )); then
        if ((required)); then fail "cannot find native file: $relative"; fi
        return
    fi
    file=$R
    for ((index=0;index<${#NATIVE_FILES[@]};index++)); do
        if [[ ${NATIVE_FILES[index]} == "$file" ]]; then
            if [[ -n ${NATIVE_ERRORS[index]} ]]; then fail "${NATIVE_ERRORS[index]}"; else R=; fi
            return
        fi
    done
    index=${#NATIVE_FILES[@]}; NATIVE_FILES+=("$file")
    NATIVE_ERRORS+=("cannot load native file: $file")
    if [[ ! -f $file || ! -r $file ]] || ! source "$file"; then
        fail "${NATIVE_ERRORS[index]}"; return
    fi
    NATIVE_ERRORS[index]=; R=; C=0
}
sy_source_file() {
    local requested=$1 direct=${2:-0} file= root module= candidate
    local -a ITEMS=() roots=()
    if [[ -z $requested ]]; then fail "cannot read file: $requested"; return; fi
    if ((direct)) || [[ $requested == /* || $requested == ./* || $requested == ../* ]]; then
        sy_path "$requested"; file=$R
    else
        sy_find_file sycol_sdk_path "$requested"; ((C)) && return
        if ((FIND)); then file=$R
        else
            sy_find_file sycol_source_path "$requested"; ((C)) && return
            if ((FIND)); then file=$R; fi
        fi
    fi
    if [[ -z $file ]]; then fail "cannot read file: $requested"; return; fi
    vget ::sycol_sdk_path; ((C)) && return
    parse_list "$R"; ((C)) && return; roots=("${ITEMS[@]}")
    for root in "${roots[@]}"; do
        [[ -z $root ]] && continue
        sy_path "$root"; candidate=${R%/}/
        if [[ $file == "$candidate"* ]]; then module=${file#"$candidate"}; break; fi
    done
    # Check/read the chosen Tcl file before executing any matching host code.
    sy_read_text "$file" "$requested"; ((C)) && return
    local text=${R//$'\r\n'/$'\n'}
    if [[ $module == *.tcl ]]; then
        load_native "${module%.tcl}.sh"; ((C)) && return
    fi
    eval_script "$text"; finish_return
}
load_sdk() {
    sy_find_file sycol_sdk_path core.tcl; ((C)) && return
    if (( ! FIND )); then fail 'cannot find SDK file: core.tcl'; return; fi
    dispatch source "$R"
}
load_version() {
    local version
    if [[ ! -f $SYCOL_HOME/../VERSION || ! -r $SYCOL_HOME/../VERSION ]]; then
        fail 'cannot read version file'; return
    fi
    version=$(< "$SYCOL_HOME/../VERSION")
    version=${version%$'\r'}
    if [[ ! $version =~ ^[0-9][0-9A-Za-z.+-]*$ ]]; then fail 'invalid version file'; return; fi
    R=$version; C=0
}
main() {
    if (($#<1)) || [[ $1 == --version && $# != 1 ]]; then
        printf 'usage: sycol script.tcl [args ...] | sycol --version\n' >&2; return 2
    fi
    load_version
    if ((C)); then printf 'sycol: %s (completion %s)\n' "$R" "$C" >&2; return 1; fi
    if [[ $1 == --version ]]; then printf '%s\n' "$R"; return 0; fi
    vset ::sycol_version "$R"
    local script=$1; shift
    quote_list "$@"; vset argv "$R"; vset argc "$#"; vset argv0 "$script"; vset sycol_host bash
    load_sdk
    if ((C==0)); then sy_source_file "$script" 1; fi
    if ((C)); then printf 'sycol: %s (completion %s)\n' "$R" "$C" >&2; return 1; fi
}
# Capture the installation location before an embedded caller can change cwd.
SYCOL_HOME=${BASH_SOURCE[0]%/*}
[[ $SYCOL_HOME == "${BASH_SOURCE[0]}" ]] && SYCOL_HOME=.
[[ $SYCOL_HOME == /* ]] || SYCOL_HOME=$PWD/$SYCOL_HOME
sy_init_paths
load_native core.sh 1
if ((C)); then
    printf 'sycol: %s (completion %s)\n' "$R" "$C" >&2
    return 1 2>/dev/null || exit 1
fi
# The Bash file is also an embedding API: source it, then call main or eval_script.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; exit $?; fi
